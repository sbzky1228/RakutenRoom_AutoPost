# =====================================================================
# 楽天ROOM自動投稿 設定ファイルのひな形
#
# 使い方:
#   1. このファイルをコピーして「.env」という名前で保存する
#      - python main.py で実行する場合: プロジェクト直下に置く
#      - .exe で実行する場合: RakutenRoomAutoPost.exe と同じフォルダに置く
#   2. 各項目を自分の情報に書き換える
#
# 注意:
#   - .env にはパスワードやAPIキーが含まれるため、Gitにコミットしたり他人に渡したりしないこと
#   - Windowsのパスを書く場合は「シングルクォート」で囲むこと
#       OK : SERVICE_ACCOUNT_PATH='C:\Users\you\service_account.json'
#       NG : SERVICE_ACCOUNT_PATH="C:\Users\you\service_account.json"
#            （ダブルクォート内では「\r」「\n」などが改行文字として解釈され、パスが壊れる）
#     ダブルクォートを使う場合は「\\」と重ねるか、「/」区切りで書く
# =====================================================================

# --- 楽天会員のログイン情報 ---
# 初回ログイン時やROOM投稿時の再認証で使用する（パスキーは使わず、パスワードでログインする）
RAKUTEN_USER_ID='your_user_id_or_email'
RAKUTEN_PASSWORD='your_password'

# --- Googleスプレッドシート ---
# スプレッドシートのURL「https://docs.google.com/spreadsheets/d/<ここ>/edit」の部分
SPREADSHEET_ID='your_spreadsheet_id'
SHEET_NAME='Sheet1'
# サービスアカウントのJSONキーのパス（相対パスの場合はこの.envがあるフォルダからの位置）
SERVICE_ACCOUNT_PATH='service_account.json'

# --- OpenAI（紹介文の生成） ---
OPENAI_API_KEY='your_openai_api_key'
# 使用するモデル（省略時は gpt-6.1-sol）
# OPENAI_MODEL='gpt-6.1-sol'

# --- Playwright（通常は指定不要） ---
# ブラウザのインストール先を変えている場合のみ指定する
# 未指定の場合、.exe実行時は %LOCALAPPDATA%\ms-playwright を自動で使用する
# PLAYWRIGHT_BROWSERS_PATH='C:\path\to\ms-playwright'
